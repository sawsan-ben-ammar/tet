# Home Suricata rules for the DoS extension (Section 14 of the brief).
# These are DETECTION rules for the two probes. threshold / detection_filter stop
# one alert being raised per packet during a flood. Load alongside the Emerging
# Threats Open "dos" category. sid range 9000000+ is reserved for home rules.

alert tcp any any -> $HOME_NET 80 (msg:"HOME DOS SYN flood vers ingress"; \
    flags:S,12; threshold: type both, track by_dst, count 500, seconds 5; \
    classtype:attempted-dos; sid:9000001; rev:1;)

alert http any any -> $HOME_NET any (msg:"HOME DOS HTTP flood - requetes repetees"; \
    flow:to_server,established; http.method; content:"GET"; \
    detection_filter: track by_dst, count 300, seconds 10; \
    classtype:attempted-dos; sid:9000002; rev:1;)

alert tcp any any -> $HOME_NET 80 (msg:"HOME DOS slowloris - connexions lentes"; \
    flow:to_server,established; \
    detection_filter: track by_src, count 50, seconds 30; \
    classtype:attempted-dos; sid:9000003; rev:1;)

alert udp any any -> $HOME_NET any (msg:"HOME DOS UDP flood"; \
    threshold: type both, track by_dst, count 800, seconds 5; \
    classtype:attempted-dos; sid:9000010; rev:1;)

alert icmp any any -> $HOME_NET any (msg:"HOME DOS ICMP flood"; itype:8; \
    threshold: type both, track by_dst, count 600, seconds 5; \
    classtype:attempted-dos; sid:9000011; rev:1;)
