# API image: serves correlation_attaque_distribuee and correlation_ids_suricata.
FROM python:3.11-slim

WORKDIR /app

# CPU-only torch to keep the image small; swap for a CUDA base if you have a GPU.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY schema ./schema
COPY data_prep ./data_prep
COPY model ./model
COPY ids ./ids
COPY deploy ./deploy

# model/artifacts and ids/artifacts are baked in at build time (train first) or
# mounted at runtime via a volume. See deploy/README.
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import httpx;httpx.get('http://localhost:8000/health').raise_for_status()"

CMD ["uvicorn", "deploy.api:app", "--host", "0.0.0.0", "--port", "8000"]
